FROM node:22.20.0-bookworm-slim

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm install --global npm@10.9.3 --no-audit --no-fund \
    && test "$(node --version)" = "v22.20.0" \
    && test "$(npm --version)" = "10.9.3"

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 3000

# Refresh the dedicated dependency volume when the lockfile changes.
CMD ["sh", "-c", "npm ci --no-audit --no-fund && exec npm run dev -- --hostname 0.0.0.0"]
