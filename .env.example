# Public backend origin, embedded into the browser at Vite build time.
# Leave empty until explicitly connecting an environment. Never put secrets here.
VITE_BACKEND_URL=

# Vercel Production environment only (set by the deployment owner):
# VITE_BACKEND_URL=https://api.game-probe.com
# Production CORS allows https://game-probe.com and https://www.game-probe.com.
# Vercel Preview and localhost are not allowed by the production backend.

# Future local FastAPI/Docker development (requires local backend CORS setup):
# VITE_BACKEND_URL=http://localhost:8000
# See docs/frontend/BACKEND-CONNECTION.md for setup and usage.
